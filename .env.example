# 한국관광공사 국문 관광정보 서비스 (KorService2)
TOUR_API_KEY=여기에_공공데이터포털_인증키를_입력하세요
TOUR_API_ENDPOINT=https://apis.data.go.kr/B551011/KorService2

# 한국관광공사 관광사진 정보 서비스 (PhotoGalleryService1, PHOTO_API_KEY 미지정 시 TOUR_API_KEY 재사용)
PHOTO_API_ENDPOINT=https://apis.data.go.kr/B551011/PhotoGalleryService1

# Google Blogger 설정
BLOGGER_BLOG_ID=여기에_블로그_ID를_입력하세요
BLOGGER_URL=https://your-blog.blogspot.com/
GOOGLE_CLIENT_SECRET_FILE=client_secret_파일명.json

# Gemini API 설정
GEMINI_API_KEY=여기에_Gemini_API_키를_입력하세요
GEMINI_MODEL=gemini-3.1-flash-lite
